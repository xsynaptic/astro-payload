---
import type { LexicalHeadingNode } from '#schemas/lexical.ts';
import type { ConverterProps } from '#types.ts';

type Props = ConverterProps<LexicalHeadingNode>;

const { dir, node, style } = Astro.props;

// A stored value never names the element, whatever the schema let through
const headingTags = new Set<string>(['h1', 'h2', 'h3', 'h4', 'h5', 'h6']);
const Tag = headingTags.has(node.tag) ? node.tag : 'h2';
---

<Tag dir={dir} style={style}>
	<slot />
</Tag>
