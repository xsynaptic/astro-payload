---
import type { LexicalAutolinkNode, LexicalLinkNode } from '#schemas/lexical.ts';
import type { ConverterProps } from '#types.ts';

import { toSafeHref } from '#safe-href.ts';

type Props = ConverterProps<LexicalAutolinkNode | LexicalLinkNode>;

const { config, dir, node } = Astro.props;

// Lexical keeps an autolink the author undid as a node, so its text survives without the anchor
const isUnlinked = 'isUnlinked' in node && node.isUnlinked === true;
---

{isUnlinked ? (
	<slot />
) : (
	<a
		dir={dir}
		href={config.siteHref(toSafeHref(node.url))}
		rel={node.rel ?? undefined}
		target={node.target ?? undefined}
		title={node.title ?? undefined}
	>
		<slot />
	</a>
)}
