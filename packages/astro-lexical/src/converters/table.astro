---
import type { LexicalTableNode } from '#schemas/lexical.ts';
import type { ConverterProps } from '#types.ts';

type Props = ConverterProps<LexicalTableNode>;

const { config, converters, dir, node, RenderNode, style } = Astro.props;

const { children } = node;
---

<div data-table-wrapper="">
	<table dir={dir} style={style}>
		<tbody>
			{children.map((child) => (
				<RenderNode config={config} converters={converters} node={child} />
			))}
		</tbody>
	</table>
</div>
