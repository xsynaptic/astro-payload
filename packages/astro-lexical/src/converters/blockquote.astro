---
import type { LexicalQuoteNode } from '#schemas/lexical.ts';
import type { ConverterProps } from '#types.ts';

type Props = ConverterProps<LexicalQuoteNode>;

const { config, converters, dir, node, RenderNode, style } = Astro.props;

const { children } = node;
---

<blockquote dir={dir} style={style}>
	{children.map((child) => (
		<RenderNode config={config} converters={converters} node={child} />
	))}
</blockquote>
