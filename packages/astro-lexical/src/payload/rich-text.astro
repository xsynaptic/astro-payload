---
import type { ConverterMapShape } from '#definitions.ts';
import type { Converters } from '#types.ts';

import { coreConverters } from '#presets.ts';
import RenderNode from '#render-node.astro';

import type { PayloadRichTextDefinitions } from './definitions.ts';
import type { PayloadRichTextProps } from './types.ts';

import { toBlockDispatch } from './blocks.ts';
import { payloadConverters } from './presets.ts';

type Props<
	T extends PayloadRichTextDefinitions = PayloadRichTextDefinitions,
	TContext = unknown,
> = PayloadRichTextProps<T, TContext>;

const { config, data } = Astro.props;
const map: ConverterMapShape | undefined = Astro.props.converters;

const converters: Converters = {
	dispatch: toBlockDispatch((section) => map?.[section] ?? {}),
	nodes: { ...coreConverters, ...payloadConverters, ...map?.nodes },
};
---

{data.root.children.map((node) => (
	<RenderNode config={config} converters={converters} node={node} />
))}
