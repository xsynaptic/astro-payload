---
import type { PayloadAutolinkNode } from '#payload/schemas.ts';
import type { ConverterProps } from '#types.ts';

import { toSafeHref } from '#safe-href.ts';

type Props = ConverterProps<PayloadAutolinkNode>;

const { config, dir, node } = Astro.props;

const rel = node.fields.newTab ? 'noopener noreferrer' : undefined;
const target = node.fields.newTab ? '_blank' : undefined;
---

<a dir={dir} href={config.siteHref(toSafeHref(node.fields.url))} rel={rel} target={target}>
	<slot />
</a>
