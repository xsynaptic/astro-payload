---
import type { PayloadLinkNode } from '#payload/schemas.ts';
import type { PayloadRichTextConfig } from '#payload/types.ts';
import type { ConverterProps } from '#types.ts';

import { resolvePayloadLinkHref } from '#payload/links.ts';

type Props = ConverterProps<PayloadLinkNode> & { config: PayloadRichTextConfig };

const { config, dir, node } = Astro.props;

const rel = node.fields.newTab ? 'noopener noreferrer' : undefined;
const target = node.fields.newTab ? '_blank' : undefined;

const href = await resolvePayloadLinkHref(node.fields, config);
---

<a dir={dir} href={href} rel={rel} target={target}>
	<slot />
</a>
