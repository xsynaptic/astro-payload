---
import type { PayloadUploadNode } from '#payload/schemas.ts';
import type { PayloadRichTextConfig } from '#payload/types.ts';
import type { ConverterProps } from '#types.ts';

import { describeUpload } from '#payload/uploads.ts';

type Props = ConverterProps<PayloadUploadNode> & { config: PayloadRichTextConfig };

// A paragraph carries the editor's alignment, which an img or picture ignores
const { config, node, style } = Astro.props;

const upload = node.value ? describeUpload(node.value, node.fields, config.uploadSizes) : undefined;
---

{upload?.kind === 'file' ? (
	<p style={style}>
		<a href={upload.href}>{upload.label}</a>
	</p>
) : undefined}
{upload?.kind === 'image' && upload.sources.length === 0 ? (
	<p style={style}>
		<img {...upload.img} alt={upload.alt} decoding="async" loading="lazy" />
	</p>
) : undefined}
{upload?.kind === 'image' && upload.sources.length > 0 ? (
	<p style={style}>
		<picture>
			{upload.sources.map((source) => (
				<source sizes={upload.sizes} srcset={source.srcset} type={source.type} />
			))}
			<img {...upload.img} alt={upload.alt} decoding="async" loading="lazy" />
		</picture>
	</p>
) : undefined}
