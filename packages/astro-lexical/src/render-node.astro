---
import type { Converters, LexicalBaseNode, RichTextConfig } from './types.ts';

import { computeNodeStyles, getConverter, getNodeDirection } from './render-node.ts';

interface Props {
	config: RichTextConfig;
	converters: Converters;
	node: LexicalBaseNode;
}

const { config, converters, node } = Astro.props;

const Converter = getConverter(node, converters);
const RenderNode = Astro.self;

const props = {
	config,
	converters,
	dir: getNodeDirection(node),
	node,
	RenderNode,
	style: computeNodeStyles(node),
};

// The parse has checked every child
const children = Array.isArray(node.children)
	? (node.children as ReadonlyArray<LexicalBaseNode>)
	: undefined;
---

{children ? (
	<Converter {...props}>
		{children.map((child) => (
			<RenderNode config={config} converters={converters} node={child} />
		))}
	</Converter>
) : (
	<Converter {...props} />
)}
