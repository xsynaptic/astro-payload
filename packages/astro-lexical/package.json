{
	"name": "@xsynaptic/astro-lexical",
	"version": "0.3.0",
	"description": "Render Lexical rich text in Astro, with a Payload preset",
	"type": "module",
	"license": "MIT",
	"author": "Alexander Synaptic <x@synapticism.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsynaptic/astro-payload.git",
		"directory": "packages/astro-lexical"
	},
	"homepage": "https://github.com/xsynaptic/astro-payload/tree/main/packages/astro-lexical#readme",
	"bugs": {
		"url": "https://github.com/xsynaptic/astro-payload/issues"
	},
	"keywords": [
		"astro",
		"astro-component",
		"withastro",
		"lexical",
		"payload",
		"rich-text"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./payload": "./src/payload/index.ts",
		"./payload/presets": "./src/payload/presets.ts",
		"./payload/rich-text.astro": "./src/payload/rich-text.astro",
		"./presets": "./src/presets.ts",
		"./rich-text.astro": "./src/rich-text.astro",
		"./safe-href": "./src/safe-href.ts"
	},
	"imports": {
		"#tests/*": "./tests/*",
		"#*": "./src/*"
	},
	"files": [
		"src"
	],
	"scripts": {
		"build": "publint",
		"check-types": "astro check && tsc --noEmit"
	},
	"peerDependencies": {
		"astro": "^7.0.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		}
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@fast-check/vitest": "^0.5.0",
		"@lexical/code": "0.50.0",
		"@lexical/extension": "0.50.0",
		"@lexical/link": "0.50.0",
		"@lexical/list": "0.50.0",
		"@lexical/rich-text": "0.50.0",
		"@lexical/table": "0.50.0",
		"@payloadcms/richtext-lexical": "3.93.0",
		"@types/node": "^24.19.2",
		"astro": "^7.4.5",
		"lexical": "0.50.0",
		"payload": "3.93.0",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0",
		"zod": "^4.6.7"
	}
}
