---
import type { ConverterMap, InternalLinkTarget } from '@xsynaptic/astro-lexical/payload';

import {
	defineBlock,
	definePayloadRichText,
	parseRichText,
} from '@xsynaptic/astro-lexical/payload';
import PayloadRichText from '@xsynaptic/astro-lexical/payload/rich-text.astro';
import { z } from 'zod';

import BadgeConverter from '#converters/badge.astro';
import document from '#documents/payload.json' with { type: 'json' };
import Layout from '#layouts/layout.astro';

const BadgeFieldsSchema = z.object({
	blockType: z.literal('badge'),
	label: z.string(),
	tone: z.enum(['info', 'warning']).optional(),
});

const richText = definePayloadRichText({ inlineBlocks: [defineBlock(BadgeFieldsSchema)] });

const converters = {
	inlineBlocks: { badge: BadgeConverter },
} satisfies ConverterMap<typeof richText>;

const { data, issues } = parseRichText(richText, document);

// The smoke build must render the document cleanly, so any issue fails it
if (!data || issues.length > 0) throw new Error(`payload document: ${JSON.stringify(issues)}`);

const config = {
	context: undefined,
	internalDocToHref: (target: InternalLinkTarget) => `/${target.relationTo}/${String(target.id)}/`,
	siteHref: (href: string) => href,
};
---

<Layout title="Payload">
	<PayloadRichText config={config} converters={converters} data={data} />
</Layout>
