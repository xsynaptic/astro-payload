---
import { defineRichText, parseRichText } from '@xsynaptic/astro-lexical';
import RichText from '@xsynaptic/astro-lexical/rich-text.astro';
import { toSafeHref } from '@xsynaptic/astro-lexical/safe-href';

import document from '#documents/core.json' with { type: 'json' };
import Layout from '#layouts/layout.astro';

const { data, issues } = parseRichText(defineRichText(), document);

// The smoke build must render the document cleanly, so any issue fails it
if (!data || issues.length > 0) throw new Error(`core document: ${JSON.stringify(issues)}`);
---

<Layout title="Core">
	<RichText data={data} />
	<a href={toSafeHref('javascript:alert(1)')}>Unsafe literal</a>
</Layout>
