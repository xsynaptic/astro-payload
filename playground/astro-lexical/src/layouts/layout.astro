---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<title>{title} · astro-lexical playground</title>
	</head>
	<body>
		<nav>
			<a href="/">Core</a> · <a href="/payload/">Payload</a>
		</nav>
		<main>
			<h1>{title}</h1>
			<slot />
		</main>
	</body>
</html>
